# Server-only. Get an nvapi-... key from https://build.nvidia.com and put it in .env.local (never commit it).
NVIDIA_NIM_API_KEY=
# Optional model overrides
NVIDIA_NIM_MODEL=openai/gpt-oss-120b
NVIDIA_NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# Optional in-memory rewrite limits per server instance
# REWRITE_RATE_LIMIT_PER_HOUR=30
# REWRITE_GLOBAL_LIMIT_PER_DAY=500
